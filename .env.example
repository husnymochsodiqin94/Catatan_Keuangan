# Salin ke .env lalu isi:  cp .env.example .env
# JANGAN commit .env (berisi rahasia).

# Domain untuk HTTPS (Caddy). Untuk uji lokal, biarkan "localhost".
DOMAIN=keuangan.contoh.com

# Token API — WAJIB diisi saat online (string acak panjang).
# Buat: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
CATATAN_TOKEN=

# 2FA email: aktif otomatis bila SMTP dikonfigurasi (kode dikirim ke email).
# Untuk UJI LOKAL tanpa SMTP, set CATATAN_2FA_DEV=1 agar kode tampil di layar.
# JANGAN diaktifkan di produksi (kode tak boleh bocor ke respons).
CATATAN_2FA_DEV=

# Email alert (opsional). Kosongkan bila belum pakai email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SSL=
